APP_ENV=local
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/neondb?ssl=require
DATABASE_URL_DIRECT=postgresql+asyncpg://USER:PASSWORD@HOST/neondb?ssl=require
JWT_SECRET=replace-with-a-random-secret
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=14
FIELD_ENCRYPTION_KEY=replace-with-a-Fernet-key
OLLAMA_HOST=http://127.0.0.1:8001
OLLAMA_API_KEY=
LLM_MODEL=gemma4:latest
LLM_TIMEOUT_S=180
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MIN=30
LOG_RETENTION_DAYS=90
HELP_SEARCH_TTL_DAYS=30
HELP_SEARCH_MAX_RESULTS=5
HELP_SEARCH_PREFER_DOMAINS=gov,gov.in,nhs.uk,who.int,findahelpline.com
EMBED_MODEL=hashing-n-gram-v1
INDEX_VERSION=current
INDEX_DIR=models_store/index
ALLOW_PEER_REVIEWED_NON_CLINICAL=false
RAM_BUDGET_MB=256
PAGE_SIZE=256
TOP_K=8
MIN_SIMILARITY=0.12
LEVEL_HIGH_THRESHOLD=0.58
LEVEL_CRITICAL_THRESHOLD=0.76
LEVEL_CONFIDENCE_THRESHOLD=0.55
LEVEL_DECAY=0.8
HYSTERESIS_TURNS=3
PREFETCH_NEIGHBOURS=2
MOOD_SMOOTHING=0.55
JWT_SECRET=paste-generated-value-here
FIELD_ENCRYPTION_KEY=paste-generated-value-here
